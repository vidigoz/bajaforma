# Copia este archivo como .env para desarrollo local (netlify dev lo carga solo).
# En producción, configura estas mismas variables en Netlify:
# Site settings → Environment variables. NUNCA subas .env a git (ya está en .gitignore).

# Cadena de conexión de tu proyecto en Neon (https://neon.tech).
# Formato: postgres://usuario:password@host/dbname?sslmode=require
DATABASE_URL=

# Dashboard (/admin/) — una sola contraseña compartida, no hay cuentas de usuario.
DASHBOARD_PASSWORD=
# Secreto para firmar la cookie de sesión del dashboard. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=

# Build Hook de Netlify (Site settings → Build & deploy → Build hooks) — lo
# usa el botón "Publicar cambios" del dashboard para redesplegar el sitio.
NETLIFY_BUILD_HOOK_URL=
