---
import type { Product } from '../lib/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const isAvailable = product.status === 'disponible';
---

{isAvailable ? (
  <a
    href={`/productos/${product.slug}/`}
    class="group block rounded-2xl border border-ocean-100 p-6 hover:border-ocean-400 hover:shadow-md transition-all bg-white"
  >
    <span class="text-3xl" aria-hidden="true">{product.emoji}</span>
    <h3 class="mt-3 font-semibold text-ink group-hover:text-ocean-600">{product.name}</h3>
    <p class="mt-1 text-sm text-ink-soft">{product.shortDescription}</p>
    <span class="mt-4 inline-block text-sm font-medium text-ocean-500">Personalizar →</span>
  </a>
) : (
  <div class="rounded-2xl border border-dashed border-ocean-100 p-6 bg-sand-100/40">
    <span class="text-3xl opacity-60" aria-hidden="true">{product.emoji}</span>
    <h3 class="mt-3 font-semibold text-ink-soft">{product.name}</h3>
    <p class="mt-1 text-sm text-ink-soft/80">{product.shortDescription}</p>
    <span class="mt-4 inline-block text-xs font-semibold uppercase tracking-wide text-ink-soft/60">Próximamente</span>
  </div>
)}
