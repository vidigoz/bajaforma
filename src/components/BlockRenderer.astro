---
import type { PageBlock } from '../lib/db';

interface Props {
  block: PageBlock;
}
const { block } = Astro.props;
const c = block.content as any;
---

{block.type === 'heading_text' && (
  <div class="prose-block">
    {c.heading && <h2 class="text-2xl font-semibold mb-3">{c.heading}</h2>}
    {(c.body || '').split('\n\n').filter(Boolean).map((para: string) => (
      <p class="text-ink-soft mb-3 last:mb-0">{para}</p>
    ))}
  </div>
)}

{block.type === 'faq' && (
  <div>
    {c.heading && <h2 class="text-2xl font-semibold mb-6">{c.heading}</h2>}
    <div class="space-y-6">
      {(c.items || []).map((item: { q: string; a: string }) => (
        <div>
          <p class="font-semibold">{item.q}</p>
          <p class="mt-1 text-ink-soft">{item.a}</p>
        </div>
      ))}
    </div>
  </div>
)}

{block.type === 'cta' && (
  <div class="rounded-2xl border border-ocean-100 bg-sand-100/40 p-8 text-center">
    {c.heading && <h2 class="text-2xl font-semibold mb-2">{c.heading}</h2>}
    {c.body && <p class="text-ink-soft mb-5 max-w-xl mx-auto">{c.body}</p>}
    {c.buttonLabel && c.buttonHref && (
      <a
        href={c.buttonHref}
        class="inline-block rounded-full bg-sunset-500 text-white font-semibold px-6 py-3 hover:bg-sunset-600 transition-colors"
      >
        {c.buttonLabel}
      </a>
    )}
  </div>
)}
