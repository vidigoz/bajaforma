---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getTexts } from '../lib/db';
import { whatsappLink } from '../lib/site';

const products = await getProducts();
const t = await getTexts();
---

<Layout
  title="Impresión 3D y productos personalizados"
  description="Diseña en línea tu producto personalizado (llaveros con nombre y más) y recibe cotización al instante. Impresión 3D en Baja California."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-14 text-center">
    <p class="inline-block text-xs font-semibold uppercase tracking-wide text-ocean-500 bg-ocean-50 rounded-full px-3 py-1">
      {t['home.hero.eyebrow']}
    </p>
    <h1 class="mt-4 text-4xl sm:text-5xl font-semibold leading-tight">
      {t['home.hero.title_pre']}<span class="text-ocean-500">{t['home.hero.title_accent']}</span>
    </h1>
    <p class="mt-4 max-w-2xl mx-auto text-ink-soft text-lg">
      {t['home.hero.subtitle']}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/productos/" class="rounded-full bg-ocean-500 text-white font-semibold px-6 py-3 hover:bg-ocean-600 transition-colors">
        {t['home.hero.cta_primary']}
      </a>
      <a
        href={whatsappLink('Hola, tengo una duda sobre impresión 3D personalizada')}
        target="_blank" rel="noopener noreferrer"
        class="rounded-full border border-ocean-100 text-ink font-semibold px-6 py-3 hover:border-sunset-400 hover:text-sunset-500 transition-colors"
      >
        {t['home.hero.cta_secondary']}
      </a>
    </div>
  </section>

  <!-- Productos destacados -->
  <section class="mx-auto max-w-6xl px-5 py-14 border-t border-ocean-100">
    <div class="flex items-end justify-between gap-4 mb-8">
      <h2 class="text-2xl font-semibold">Productos personalizados</h2>
      <a href="/productos/" class="text-sm font-medium text-ocean-500 hover:text-ocean-600 whitespace-nowrap">Ver todos →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="bg-sand-100/50 border-t border-ocean-100">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-2xl font-semibold mb-8 text-center">{t['home.how.title']}</h2>
      <div class="grid gap-8 sm:grid-cols-3 text-center">
        <div>
          <div class="mx-auto w-10 h-10 rounded-full bg-ocean-500 text-white flex items-center justify-center font-bold font-mono">1</div>
          <p class="mt-3 font-semibold">{t['home.how.step1.title']}</p>
          <p class="mt-1 text-sm text-ink-soft">{t['home.how.step1.body']}</p>
        </div>
        <div>
          <div class="mx-auto w-10 h-10 rounded-full bg-ocean-500 text-white flex items-center justify-center font-bold font-mono">2</div>
          <p class="mt-3 font-semibold">{t['home.how.step2.title']}</p>
          <p class="mt-1 text-sm text-ink-soft">{t['home.how.step2.body']}</p>
        </div>
        <div>
          <div class="mx-auto w-10 h-10 rounded-full bg-ocean-500 text-white flex items-center justify-center font-bold font-mono">3</div>
          <p class="mt-3 font-semibold">{t['home.how.step3.title']}</p>
          <p class="mt-1 text-sm text-ink-soft">{t['home.how.step3.body']}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
