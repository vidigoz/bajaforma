---
import Layout from '../../layouts/Layout.astro';
import { siteConfig, whatsappLink } from '../../lib/site';
---

<Layout
  title="Contacto"
  description="Escríbenos para cotizar tu producto personalizado impreso en 3D o resolver dudas sobre materiales, tiempos y envíos."
>
  <section class="mx-auto max-w-2xl px-5 py-14">
    <h1 class="text-3xl font-semibold">Contacto</h1>
    <p class="mt-3 text-ink-soft">
      La forma más rápida de cotizar es por{' '}
      <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="text-ocean-500 hover:text-ocean-600 font-medium">WhatsApp</a>.
      También puedes escribirnos aquí y te respondemos por correo.
    </p>

    <form id="contact-form" class="mt-8 space-y-4" novalidate>
      <div>
        <label for="name" class="block text-sm font-medium text-ink mb-1">Nombre *</label>
        <input id="name" name="name" type="text" required maxlength="120"
          class="w-full rounded-lg border border-ocean-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ocean-400" />
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-sm font-medium text-ink mb-1">Correo</label>
          <input id="email" name="email" type="email" maxlength="160"
            class="w-full rounded-lg border border-ocean-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ocean-400" />
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-ink mb-1">Teléfono / WhatsApp</label>
          <input id="phone" name="phone" type="tel" maxlength="40"
            class="w-full rounded-lg border border-ocean-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ocean-400" />
        </div>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-ink mb-1">Mensaje *</label>
        <textarea id="message" name="message" rows="5" required maxlength="2000"
          class="w-full rounded-lg border border-ocean-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ocean-400"
          placeholder="Cuéntanos qué quieres imprimir, cantidad, y para cuándo lo necesitas."></textarea>
      </div>

      <button type="submit" id="submit-btn"
        class="rounded-full bg-sunset-500 text-white font-semibold px-6 py-3 hover:bg-sunset-600 transition-colors disabled:opacity-60">
        Enviar mensaje
      </button>

      <p id="form-status" class="text-sm mt-2" role="status" aria-live="polite"></p>
    </form>

    <p class="mt-6 text-sm text-ink-soft">
      También puedes escribirnos directo a{' '}
      <a href={`mailto:${siteConfig.email}`} class="text-ocean-500 hover:text-ocean-600 font-medium">{siteConfig.email}</a>.
    </p>
  </section>

  <script is:inline>
    // Progresivo: si falla el fetch (función/Neon no configurados aún),
    // mostramos el error y dejamos WhatsApp/correo como alternativa visible arriba.
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      status.textContent = 'Enviando…';
      status.className = 'text-sm mt-2 text-ink-soft';

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Error al enviar.');

        status.textContent = '¡Listo! Te responderemos pronto.';
        status.className = 'text-sm mt-2 text-ocean-600 font-medium';
        form.reset();
      } catch (err) {
        status.textContent = err.message || 'No se pudo enviar. Intenta por WhatsApp.';
        status.className = 'text-sm mt-2 text-red-600 font-medium';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Layout>
