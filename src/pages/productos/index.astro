---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../lib/products';
---

<Layout
  title="Productos personalizados"
  description="Catálogo de productos personalizables de Bajaforma: configura tu diseño en línea y descarga o cotiza tu impresión 3D al instante."
>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <h1 class="text-3xl font-semibold">Productos personalizados</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Cada producto tiene su propio configurador: ajusta el diseño en tu navegador y mira el
      resultado en 3D antes de pedirlo. Vamos agregando productos nuevos con el tiempo.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</Layout>
