---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard" description="Panel de administración de Bajaforma." noindex={true}>
  <div class="mx-auto max-w-4xl px-5 py-10">

    <!-- ═══════ LOGIN ═══════ -->
    <section id="login-view" class="max-w-sm mx-auto py-20">
      <h1 class="text-2xl font-semibold text-center mb-6">Bajaforma · Dashboard</h1>
      <form id="login-form" class="space-y-3">
        <input
          id="login-password" type="password" placeholder="Contraseña" required
          class="w-full rounded-lg border border-ocean-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ocean-400"
        />
        <button type="submit" class="w-full rounded-full bg-ocean-500 text-white font-semibold px-6 py-3 hover:bg-ocean-600 transition-colors">
          Entrar
        </button>
        <p id="login-error" class="text-sm text-red-600 hidden"></p>
      </form>
    </section>

    <!-- ═══════ DASHBOARD ═══════ -->
    <section id="dashboard-view" class="hidden">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-semibold">Dashboard</h1>
        <button id="logout-btn" class="text-sm text-ink-soft hover:text-ocean-600">Cerrar sesión</button>
      </div>

      <div class="flex gap-1 border-b border-ocean-100 mb-8 overflow-x-auto" role="tablist">
        <button data-tab="productos" class="tab-btn">Productos</button>
        <button data-tab="textos" class="tab-btn">Textos</button>
        <button data-tab="paginas" class="tab-btn">Páginas</button>
        <button data-tab="publicar" class="tab-btn">Publicar</button>
      </div>

      <!-- --- Productos --- -->
      <div id="tab-productos" class="tab-panel hidden space-y-4">
        <div id="productos-list" class="space-y-3"></div>
        <button id="producto-nuevo-btn" class="btn-sec">+ Nuevo producto</button>
      </div>

      <!-- --- Textos --- -->
      <div id="tab-textos" class="tab-panel hidden space-y-4">
        <p class="text-sm text-ink-soft">Los textos que ya existen en el sitio. Edita y guarda uno por uno.</p>
        <div id="textos-list" class="space-y-4"></div>
      </div>

      <!-- --- Páginas --- -->
      <div id="tab-paginas" class="tab-panel hidden space-y-4">
        <div id="paginas-list" class="space-y-3"></div>
        <button id="pagina-nueva-btn" class="btn-sec">+ Nueva página</button>
        <div id="pagina-editor" class="hidden mt-8 border-t border-ocean-100 pt-8"></div>
      </div>

      <!-- --- Publicar --- -->
      <div id="tab-publicar" class="tab-panel hidden">
        <p class="text-ink-soft mb-4">
          Los cambios de arriba ya quedaron guardados en la base de datos. El sitio público es
          estático — hasta que no publiques, sigue mostrando la versión anterior.
        </p>
        <button id="publicar-btn" class="rounded-full bg-sunset-500 text-white font-semibold px-6 py-3 hover:bg-sunset-600 transition-colors">
          Publicar cambios
        </button>
        <p id="publicar-status" class="text-sm mt-3"></p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .tab-btn { padding: 10px 16px; font-size: 14px; font-weight: 600; color: var(--color-ink-soft); border-bottom: 2px solid transparent; white-space: nowrap; }
  .tab-btn.active { color: var(--color-ocean-600); border-color: var(--color-ocean-500); }
  .btn-sec { border: 1.5px solid var(--color-ocean-400); color: var(--color-ocean-600); font-weight: 600; padding: 8px 18px; border-radius: 999px; font-size: 14px; }
  .btn-sec:hover { background: var(--color-ocean-50); }
  .btn-danger { color: #b42318; font-size: 13px; font-weight: 600; }
  .field { display: block; width: 100%; border: 1px solid var(--color-ocean-100); border-radius: 8px; padding: 8px 10px; font-size: 14px; }
  .field:focus { outline: none; box-shadow: 0 0 0 2px var(--color-ocean-100); border-color: var(--color-ocean-400); }
  .card { border: 1px solid var(--color-ocean-100); border-radius: 12px; padding: 16px; background: white; }
  .thumb-box { width: 88px; height: 88px; flex-shrink: 0; border-radius: 10px; overflow: hidden; background: var(--color-ocean-50); display: flex; align-items: center; justify-content: center; }
  .thumb-img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-emoji { font-size: 32px; }
</style>

<script is:inline>
(function () {
  const $ = (sel, root) => (root || document).querySelector(sel);
  const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));

  async function api(path, opts) {
    const res = await fetch(path, {
      ...opts,
      headers: { 'content-type': 'application/json', ...(opts && opts.headers) }
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || ('Error ' + res.status));
    return data;
  }

  // ═══════ Auth ═══════
  async function checkSession() {
    try {
      const { authenticated } = await api('/api/admin/session');
      showApp(authenticated);
    } catch {
      showApp(false);
    }
  }

  function showApp(authenticated) {
    $('#login-view').classList.toggle('hidden', authenticated);
    $('#dashboard-view').classList.toggle('hidden', !authenticated);
    if (authenticated) initDashboard();
  }

  $('#login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('#login-error');
    err.classList.add('hidden');
    try {
      await api('/api/admin/login', { method: 'POST', body: JSON.stringify({ password: $('#login-password').value }) });
      showApp(true);
    } catch (ex) {
      err.textContent = ex.message;
      err.classList.remove('hidden');
    }
  });

  $('#logout-btn').addEventListener('click', async () => {
    await api('/api/admin/logout', { method: 'POST' }).catch(() => {});
    showApp(false);
  });

  // ═══════ Tabs ═══════
  let dashboardStarted = false;
  function initDashboard() {
    if (dashboardStarted) return;
    dashboardStarted = true;

    $$('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => selectTab(btn.dataset.tab));
    });
    selectTab('productos');
  }

  function selectTab(name) {
    $$('.tab-btn').forEach((b) => b.classList.toggle('active', b.dataset.tab === name));
    $$('.tab-panel').forEach((p) => p.classList.toggle('hidden', p.id !== 'tab-' + name));
    if (name === 'productos') loadProductos();
    if (name === 'textos') loadTextos();
    if (name === 'paginas') loadPaginas();
  }

  // ═══════ Productos ═══════
  const MAX_IMAGE_BYTES = 3 * 1024 * 1024;

  function fileToDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function thumbPreviewHtml(p) {
    return p.image_key
      ? `<img class="thumb-img" src="/api/product-image?key=${encodeURIComponent(p.image_key)}" alt="">`
      : `<span class="thumb-emoji">${p.emoji || '✨'}</span>`;
  }

  function productoCard(p) {
    const div = document.createElement('div');
    div.className = 'card';
    div.dataset.imageKey = p.image_key || '';
    div.innerHTML = `
      <div class="flex gap-4 mb-3">
        <div class="thumb-box">${thumbPreviewHtml(p)}</div>
        <div class="flex flex-col justify-center gap-1">
          <label class="btn-sec" style="cursor:pointer;text-align:center">
            Subir foto
            <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="f-image-input hidden">
          </label>
          <button type="button" class="remove-image-btn text-xs text-ink-soft hover:text-red-600 ${p.image_key ? '' : 'hidden'}">Quitar foto</button>
          <span class="image-msg text-xs text-ink-soft"></span>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <div><label class="text-xs text-ink-soft">Slug</label><input class="field f-slug" value="${p.slug || ''}"></div>
        <div><label class="text-xs text-ink-soft">Nombre</label><input class="field f-name" value="${p.name || ''}"></div>
        <div class="sm:col-span-2"><label class="text-xs text-ink-soft">Descripción</label><input class="field f-desc" value="${(p.short_description || '').replace(/"/g, '&quot;')}"></div>
        <div><label class="text-xs text-ink-soft">Emoji (si no subes foto)</label><input class="field f-emoji" value="${p.emoji || ''}"></div>
        <div>
          <label class="text-xs text-ink-soft">Estado</label>
          <select class="field f-status">
            <option value="disponible" ${p.status === 'disponible' ? 'selected' : ''}>Disponible</option>
            <option value="proximamente" ${p.status === 'proximamente' ? 'selected' : ''}>Próximamente</option>
          </select>
        </div>
        <div><label class="text-xs text-ink-soft">Orden</label><input class="field f-order" type="number" value="${p.sort_order ?? 0}"></div>
      </div>
      <div class="flex items-center gap-4 mt-3">
        <button class="btn-sec save-btn">Guardar</button>
        <button class="btn-danger del-btn">Eliminar</button>
        <span class="msg text-sm text-ink-soft"></span>
      </div>
    `;

    const imageMsg = $('.image-msg', div);
    $('.f-image-input', div).addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > MAX_IMAGE_BYTES) {
        imageMsg.textContent = 'Máx. 3MB.';
        return;
      }
      imageMsg.textContent = 'Subiendo…';
      try {
        const dataUrl = await fileToDataUrl(file);
        const { key, url } = await api('/api/admin/upload-image', {
          method: 'POST',
          body: JSON.stringify({ dataUrl, previousKey: div.dataset.imageKey || undefined })
        });
        div.dataset.imageKey = key;
        $('.thumb-box', div).innerHTML = `<img class="thumb-img" src="${url}" alt="">`;
        $('.remove-image-btn', div).classList.remove('hidden');
        imageMsg.textContent = 'Subida ✓';
      } catch (ex) {
        imageMsg.textContent = ex.message;
      }
    });
    $('.remove-image-btn', div).addEventListener('click', () => {
      div.dataset.imageKey = '';
      $('.thumb-box', div).innerHTML = `<span class="thumb-emoji">${$('.f-emoji', div).value.trim() || '✨'}</span>`;
      $('.remove-image-btn', div).classList.add('hidden');
      imageMsg.textContent = '';
    });

    const msg = $('.msg', div);
    $('.save-btn', div).addEventListener('click', async () => {
      msg.textContent = 'Guardando…';
      try {
        await api('/api/admin/products', {
          method: p.id ? 'PUT' : 'POST',
          body: JSON.stringify({
            id: p.id,
            slug: $('.f-slug', div).value.trim(),
            name: $('.f-name', div).value.trim(),
            short_description: $('.f-desc', div).value.trim(),
            emoji: $('.f-emoji', div).value.trim(),
            image_key: div.dataset.imageKey || null,
            status: $('.f-status', div).value,
            sort_order: Number($('.f-order', div).value) || 0
          })
        });
        msg.textContent = 'Guardado ✓';
        if (!p.id) loadProductos();
      } catch (ex) {
        msg.textContent = ex.message;
      }
    });
    $('.del-btn', div).addEventListener('click', async () => {
      if (!p.id) { div.remove(); return; }
      if (!confirm('¿Eliminar este producto?')) return;
      await api('/api/admin/products?id=' + p.id, { method: 'DELETE' });
      loadProductos();
    });
    return div;
  }

  async function loadProductos() {
    const list = $('#productos-list');
    list.innerHTML = 'Cargando…';
    try {
      const { products } = await api('/api/admin/products');
      list.innerHTML = '';
      products.forEach((p) => list.appendChild(productoCard(p)));
    } catch (ex) {
      list.textContent = ex.message;
    }
  }
  $('#producto-nuevo-btn').addEventListener('click', () => {
    $('#productos-list').appendChild(productoCard({ status: 'proximamente', sort_order: 0 }));
  });

  // ═══════ Textos ═══════
  async function loadTextos() {
    const list = $('#textos-list');
    list.innerHTML = 'Cargando…';
    try {
      const { texts } = await api('/api/admin/texts');
      list.innerHTML = '';
      texts.forEach((t) => {
        const div = document.createElement('div');
        div.className = 'card';
        const isLong = t.value.length > 80;
        div.innerHTML = `
          <label class="text-xs text-ink-soft font-mono">${t.key}</label>
          ${isLong
            ? `<textarea class="field f-val" rows="3">${t.value}</textarea>`
            : `<input class="field f-val" value="${t.value.replace(/"/g, '&quot;')}">`}
          <div class="flex items-center gap-3 mt-2">
            <button class="btn-sec save-btn">Guardar</button>
            <span class="msg text-sm text-ink-soft"></span>
          </div>
        `;
        const msg = $('.msg', div);
        $('.save-btn', div).addEventListener('click', async () => {
          msg.textContent = 'Guardando…';
          try {
            await api('/api/admin/texts', { method: 'PUT', body: JSON.stringify({ key: t.key, value: $('.f-val', div).value }) });
            msg.textContent = 'Guardado ✓';
          } catch (ex) { msg.textContent = ex.message; }
        });
        list.appendChild(div);
      });
    } catch (ex) {
      list.textContent = ex.message;
    }
  }

  // ═══════ Páginas ═══════
  async function loadPaginas() {
    const list = $('#paginas-list');
    list.innerHTML = 'Cargando…';
    $('#pagina-editor').classList.add('hidden');
    try {
      const { pages } = await api('/api/admin/pages');
      list.innerHTML = '';
      pages.forEach((p) => list.appendChild(paginaRow(p)));
    } catch (ex) {
      list.textContent = ex.message;
    }
  }

  function paginaRow(p) {
    const div = document.createElement('div');
    div.className = 'card flex items-center justify-between gap-3';
    div.innerHTML = `
      <div>
        <p class="font-semibold">${p.title} <span class="text-xs text-ink-soft font-mono">/paginas/${p.slug}/</span></p>
        <p class="text-xs text-ink-soft">${p.published ? 'Publicada' : 'Borrador'}${p.nav_label ? ' · en menú: "' + p.nav_label + '"' : ''}</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <button class="btn-sec edit-btn">Editar</button>
        <button class="btn-danger del-btn">Eliminar</button>
      </div>
    `;
    $('.edit-btn', div).addEventListener('click', () => openPaginaEditor(p));
    $('.del-btn', div).addEventListener('click', async () => {
      if (!confirm('¿Eliminar esta página y todos sus bloques?')) return;
      await api('/api/admin/pages?id=' + p.id, { method: 'DELETE' });
      loadPaginas();
    });
    return div;
  }

  $('#pagina-nueva-btn').addEventListener('click', () => {
    openPaginaEditor({ published: true, sort_order: 0 });
  });

  const BLOCK_LABELS = { heading_text: 'Texto', faq: 'Preguntas frecuentes', cta: 'Llamado a la acción' };

  function blockFieldsHtml(type, c) {
    c = c || {};
    if (type === 'heading_text') {
      return `
        <label class="text-xs text-ink-soft">Encabezado (opcional)</label>
        <input class="field f-heading" value="${(c.heading || '').replace(/"/g, '&quot;')}">
        <label class="text-xs text-ink-soft mt-2 block">Texto (separa párrafos con línea en blanco)</label>
        <textarea class="field f-body" rows="4">${c.body || ''}</textarea>
      `;
    }
    if (type === 'cta') {
      return `
        <label class="text-xs text-ink-soft">Encabezado</label>
        <input class="field f-heading" value="${(c.heading || '').replace(/"/g, '&quot;')}">
        <label class="text-xs text-ink-soft mt-2 block">Texto</label>
        <textarea class="field f-body" rows="2">${c.body || ''}</textarea>
        <div class="grid sm:grid-cols-2 gap-3 mt-2">
          <div><label class="text-xs text-ink-soft">Texto del botón</label><input class="field f-btnlabel" value="${(c.buttonLabel || '').replace(/"/g, '&quot;')}"></div>
          <div><label class="text-xs text-ink-soft">Link del botón</label><input class="field f-btnhref" value="${(c.buttonHref || '').replace(/"/g, '&quot;')}"></div>
        </div>
      `;
    }
    // faq
    const items = c.items && c.items.length ? c.items : [{ q: '', a: '' }];
    return `
      <label class="text-xs text-ink-soft">Encabezado (opcional)</label>
      <input class="field f-heading" value="${(c.heading || '').replace(/"/g, '&quot;')}">
      <div class="faq-items space-y-2 mt-2">
        ${items.map((it, i) => `
          <div class="faq-item grid gap-1 border-l-2 border-ocean-100 pl-3">
            <input class="field f-q" data-i="${i}" placeholder="Pregunta" value="${(it.q || '').replace(/"/g, '&quot;')}">
            <textarea class="field f-a" data-i="${i}" placeholder="Respuesta" rows="2">${it.a || ''}</textarea>
          </div>
        `).join('')}
      </div>
      <button type="button" class="btn-sec add-faq-btn mt-2" style="font-size:12px;padding:4px 12px">+ pregunta</button>
    `;
  }

  function readBlockContent(type, div) {
    if (type === 'heading_text') {
      return { heading: $('.f-heading', div).value.trim(), body: $('.f-body', div).value.trim() };
    }
    if (type === 'cta') {
      return {
        heading: $('.f-heading', div).value.trim(),
        body: $('.f-body', div).value.trim(),
        buttonLabel: $('.f-btnlabel', div).value.trim(),
        buttonHref: $('.f-btnhref', div).value.trim()
      };
    }
    const qs = $$('.f-q', div), as = $$('.f-a', div);
    const items = qs.map((q, i) => ({ q: q.value.trim(), a: as[i].value.trim() })).filter((it) => it.q || it.a);
    return { heading: $('.f-heading', div).value.trim(), items };
  }

  function blockCard(block, page) {
    const div = document.createElement('div');
    div.className = 'card';
    div.dataset.type = block.type;
    div.innerHTML = `
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-ocean-500">${BLOCK_LABELS[block.type] || block.type}</p>
        <div class="flex gap-2 items-center">
          <button class="up-btn text-ink-soft" title="Subir">↑</button>
          <button class="down-btn text-ink-soft" title="Bajar">↓</button>
          <button class="del-block-btn btn-danger">Eliminar</button>
        </div>
      </div>
      <div class="fields">${blockFieldsHtml(block.type, block.content)}</div>
      <div class="flex items-center gap-3 mt-3">
        <button class="btn-sec save-block-btn">Guardar bloque</button>
        <span class="msg text-sm text-ink-soft"></span>
      </div>
    `;
    if (block.type === 'faq') {
      $('.add-faq-btn', div).addEventListener('click', () => {
        const wrap = $('.faq-items', div);
        const i = $$('.f-q', div).length;
        const item = document.createElement('div');
        item.className = 'faq-item grid gap-1 border-l-2 border-ocean-100 pl-3';
        item.innerHTML = `<input class="field f-q" data-i="${i}" placeholder="Pregunta"><textarea class="field f-a" data-i="${i}" placeholder="Respuesta" rows="2"></textarea>`;
        wrap.appendChild(item);
      });
    }
    const msg = $('.msg', div);
    $('.save-block-btn', div).addEventListener('click', async () => {
      msg.textContent = 'Guardando…';
      try {
        const content = readBlockContent(block.type, div);
        if (block.id) {
          await api('/api/admin/blocks', { method: 'PUT', body: JSON.stringify({ id: block.id, position: block.position, content }) });
        } else {
          const { block: created } = await api('/api/admin/blocks', {
            method: 'POST',
            body: JSON.stringify({ page_id: page.id, type: block.type, position: block.position, content })
          });
          block.id = created.id;
        }
        msg.textContent = 'Guardado ✓';
      } catch (ex) { msg.textContent = ex.message; }
    });
    $('.del-block-btn', div).addEventListener('click', async () => {
      if (block.id) {
        if (!confirm('¿Eliminar este bloque?')) return;
        await api('/api/admin/blocks?id=' + block.id, { method: 'DELETE' });
      }
      div.remove();
    });
    $('.up-btn', div).addEventListener('click', () => moveBlock(div, -1));
    $('.down-btn', div).addEventListener('click', () => moveBlock(div, 1));
    return div;
  }

  function moveBlock(div, dir) {
    const parent = div.parentElement;
    const sib = dir < 0 ? div.previousElementSibling : div.nextElementSibling;
    if (!sib) return;
    if (dir < 0) parent.insertBefore(div, sib);
    else parent.insertBefore(sib, div);
  }

  async function openPaginaEditor(p) {
    const editor = $('#pagina-editor');
    editor.classList.remove('hidden');
    editor.innerHTML = `
      <h2 class="text-xl font-semibold mb-4">${p.id ? 'Editar página' : 'Nueva página'}</h2>
      <div class="card space-y-3 mb-6">
        <div class="grid sm:grid-cols-2 gap-3">
          <div><label class="text-xs text-ink-soft">Slug (URL: /paginas/…/)</label><input class="field e-slug" value="${p.slug || ''}"></div>
          <div><label class="text-xs text-ink-soft">Título</label><input class="field e-title" value="${p.title || ''}"></div>
          <div class="sm:col-span-2"><label class="text-xs text-ink-soft">Descripción (SEO)</label><input class="field e-desc" value="${(p.meta_description || '').replace(/"/g, '&quot;')}"></div>
          <div><label class="text-xs text-ink-soft">Nombre en el menú (vacío = no aparece)</label><input class="field e-nav" value="${p.nav_label || ''}"></div>
          <div>
            <label class="text-xs text-ink-soft flex items-center gap-2 mt-4">
              <input type="checkbox" class="e-published" ${p.published !== false ? 'checked' : ''}> Publicada
            </label>
          </div>
        </div>
        <button class="btn-sec save-page-btn">Guardar página</button>
        <span class="page-msg text-sm text-ink-soft"></span>
      </div>
      ${p.id ? '<div id="blocks-list" class="space-y-4 mb-4"></div><div class="flex gap-2 flex-wrap" id="add-block-row"></div>' : '<p class="text-sm text-ink-soft">Guarda la página primero para poder agregarle secciones.</p>'}
    `;
    const pageMsg = $('.page-msg', editor);
    $('.save-page-btn', editor).addEventListener('click', async () => {
      pageMsg.textContent = 'Guardando…';
      try {
        const body = {
          id: p.id,
          slug: $('.e-slug', editor).value.trim(),
          title: $('.e-title', editor).value.trim(),
          meta_description: $('.e-desc', editor).value.trim(),
          nav_label: $('.e-nav', editor).value.trim() || null,
          published: $('.e-published', editor).checked,
          sort_order: p.sort_order ?? 0
        };
        const { page } = await api('/api/admin/pages', { method: p.id ? 'PUT' : 'POST', body: JSON.stringify(body) });
        pageMsg.textContent = 'Guardado ✓';
        loadPaginas();
        openPaginaEditor(page);
      } catch (ex) { pageMsg.textContent = ex.message; }
    });

    if (p.id) {
      const blocksList = $('#blocks-list', editor);
      const addRow = $('#add-block-row', editor);
      Object.keys(BLOCK_LABELS).forEach((type) => {
        const btn = document.createElement('button');
        btn.className = 'btn-sec';
        btn.textContent = '+ ' + BLOCK_LABELS[type];
        btn.addEventListener('click', () => {
          blocksList.appendChild(blockCard({ type, position: blocksList.children.length, content: {} }, p));
        });
        addRow.appendChild(btn);
      });

      try {
        const { blocks } = await api('/api/admin/blocks?page_id=' + p.id);
        blocks.forEach((b) => blocksList.appendChild(blockCard(b, p)));
      } catch (ex) {
        blocksList.textContent = ex.message;
      }
    }
  }

  // ═══════ Publicar ═══════
  $('#publicar-btn').addEventListener('click', async () => {
    const status = $('#publicar-status');
    status.textContent = 'Publicando…';
    try {
      const r = await api('/api/admin/publish', { method: 'POST' });
      status.textContent = r.message || (r.triggered ? 'Publicado.' : 'Guardado.');
    } catch (ex) {
      status.textContent = ex.message;
    }
  });

  checkSession();
})();
</script>
